# =============================================================================
# Innova ARCO · Environment variables
# Copy to `.env.local` and fill in the real values.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> "anon" / "publishable" key (browser-safe).
# You may use either variable name; the app reads ANON first, then PUBLISHABLE.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Project Settings -> API Keys -> "service_role" / "secret" key.
# SERVER ONLY. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
# Public base URL used to build the "review request" link inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (email notifications) -------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend. For quick local testing you may use:
# RESEND_FROM_EMAIL="Innova ARCO <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Innova ARCO <notificaciones@your-domain.com>"

# Shared secret that protects POST /api/notify-provider (used by DB webhooks).
NOTIFY_WEBHOOK_SECRET=change-me-to-a-long-random-string

# =============================================================================
# Innova ARCO · Environment variables
# Copy to `.env.local` and fill in the real values.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> "anon" / "publishable" key (browser-safe).
# You may use either variable name; the app reads ANON first, then PUBLISHABLE.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Project Settings -> API Keys -> "service_role" / "secret" key.
# SERVER ONLY. Never expose it with a NEXT_PUBLIC_ prefix.
# Required for Supabase Storage (upload/delete) and the deletion cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
# Public base URL used to build the links inside emails.
# It can be your Vercel default domain — no custom domain required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Video storage (Supabase Storage) ---------------------------------------
# Driver used by lib/storage.ts. Only "supabase" is implemented in the MVP.
STORAGE_DRIVER=supabase
# Private bucket for the recordings (created by migration 0009).
STORAGE_BUCKET=recordings
# Optional: override the max recording size the app accepts (in MB).
# Must stay <= the Supabase Storage "Global file size limit" (50 MB on Free).
# STORAGE_MAX_UPLOAD_MB=50

# --- Deletion cron ----------------------------------------------------------
# Protects GET /api/cron/process-deletions. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me-to-a-long-random-string

# --- Resend (email notifications) — OPTIONAL --------------------------------
# The app works without these: invitations are accepted inside the app and no
# email is sent (delivery is best-effort).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL="Innova ARCO <onboarding@resend.dev>"
